@page "/suppliers"
@attribute [Authorize(Policy = Permissions.SuppliersManage)]
@inject ISupplierService SupplierSvc
@inject IAuthService Auth

<div class="page-header">
    <h1 class="page-title">Suppliers</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenAdd">+ Add supplier</button>
</div>

@if (_message is not null)
{
    <div class="alert alert-success" role="status">@_message</div>
}
@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}

<div class="card">
    <div class="toolbar">
        <input class="input" placeholder="Search suppliers..." @bind="_search" @bind:event="oninput" />
        <select class="input" @bind="_statusFilter">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="All">All</option>
        </select>
    </div>

    @if (_loading)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        var rows = Filtered.ToList();
        if (rows.Count == 0)
        {
            <div class="empty-state">No suppliers found.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Supplier</th><th>Contact person</th><th>Phone</th><th>Email</th>
                            <th class="num">Lead time</th><th class="num">Items</th><th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.ContactPerson</td>
                            <td>@r.Phone</td>
                            <td>@r.Email</td>
                            <td class="num">@r.LeadTimeDays day(s)</td>
                            <td class="num">@r.ItemCount</td>
                            <td><Badge Kind="@(r.Status == RecordStatus.Active ? "ok" : "muted")" Text="@r.Status.ToString()" /></td>
                            <td class="actions">
                                <button type="button" class="btn btn-sm btn-secondary" @onclick="() => OpenEdit(r)">Edit</button>
                                <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _toggle = r">
                                    @(r.Status == RecordStatus.Active ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_form is not null)
{
    <Modal Title="@(_form.SupplierId == 0 ? "Add supplier" : "Edit supplier")" OnClose="CloseForm">
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            @if (_formError is not null)
            {
                <div class="alert alert-error" role="alert">@_formError</div>
            }

            <div class="form-grid">
                <div class="span-2">
                    <label for="sup-name">Supplier name</label>
                    <InputText id="sup-name" class="input" @bind-Value="_form.SupplierName" />
                    <ValidationMessage For="() => _form.SupplierName" />
                </div>
                <div>
                    <label for="sup-contact">Contact person</label>
                    <InputText id="sup-contact" class="input" @bind-Value="_form.ContactPerson" />
                </div>
                <div>
                    <label for="sup-phone">Phone</label>
                    <InputText id="sup-phone" class="input" @bind-Value="_form.Phone" />
                </div>
                <div>
                    <label for="sup-email">Email</label>
                    <InputText id="sup-email" class="input" @bind-Value="_form.Email" />
                </div>
                <div>
                    <label for="sup-lead">Lead time (days)</label>
                    <InputNumber id="sup-lead" class="input" @bind-Value="_form.LeadTimeDays" />
                    <ValidationMessage For="() => _form.LeadTimeDays" />
                </div>
                <div class="span-2">
                    <label for="sup-address">Address</label>
                    <InputText id="sup-address" class="input" @bind-Value="_form.Address" />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "Saving..." : "Save")</button>
            </div>
        </EditForm>
    </Modal>
}

@if (_toggle is not null)
{
    <ConfirmDialog Title="@(_toggle.Status == RecordStatus.Active ? "Deactivate supplier?" : "Activate supplier?")"
                   Message="@($"{(_toggle.Status == RecordStatus.Active ? "Deactivate" : "Activate")} the supplier '{_toggle.Name}'?")"
                   ConfirmText="@(_toggle.Status == RecordStatus.Active ? "Deactivate" : "Activate")"
                   Danger="@(_toggle.Status == RecordStatus.Active)"
                   Busy="_busy"
                   OnConfirm="ConfirmToggleAsync"
                   OnCancel="() => _toggle = null" />
}

@code {
    private List<SupplierRow> _all = new();
    private bool _loading = true;
    private bool _busy;
    private string _search = string.Empty;
    private string _statusFilter = "Active";
    private string? _message, _error, _formError;
    private SupplierInput? _form;
    private SupplierRow? _toggle;

    private IEnumerable<SupplierRow> Filtered => _all
        .Where(s => string.IsNullOrWhiteSpace(_search)
                    || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (s.ContactPerson ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(s => _statusFilter == "All" || s.Status.ToString() == _statusFilter);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _all = await SupplierSvc.ListAsync();
        }
        catch (Exception ex)
        {
            AppLogger.Error("Loading suppliers failed.", ex);
            _error = ServiceMessages.LoadFailed;
        }
        _loading = false;
    }

    private void OpenAdd()
    {
        _message = _error = _formError = null;
        _form = new SupplierInput();
    }

    private void OpenEdit(SupplierRow r)
    {
        _message = _error = _formError = null;
        _form = new SupplierInput
        {
            SupplierId = r.SupplierId, SupplierName = r.Name, ContactPerson = r.ContactPerson,
            Phone = r.Phone, Email = r.Email, Address = r.Address, LeadTimeDays = r.LeadTimeDays
        };
    }

    private void CloseForm() => _form = null;

    private async Task SaveAsync()
    {
        if (_form is null) return;
        _busy = true;
        _formError = null;
        var result = await SupplierSvc.SaveAsync(_form, Auth.Current!.UserId);
        _busy = false;

        if (result.Success)
        {
            _form = null;
            _message = result.Message;
            await LoadAsync();
        }
        else
        {
            _formError = result.Error;
        }
    }

    private async Task ConfirmToggleAsync()
    {
        if (_toggle is null) return;
        _busy = true;
        var makeActive = _toggle.Status != RecordStatus.Active;
        var result = await SupplierSvc.SetActiveAsync(_toggle.SupplierId, makeActive, Auth.Current!.UserId);
        _busy = false;
        _toggle = null;

        _message = result.Success ? result.Message : null;
        _error = result.Success ? null : result.Error;
        await LoadAsync();
    }
}
